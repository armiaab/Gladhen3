<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Gladhen3</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<!-- SIZE: without a concrete RID the RID-agnostic asset copy drops EVERY
		     architecture's natives into EVERY package (x86 msix shipped arm64+x64 Skia). -->
		<RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
		<!-- Analyzers on: CA1031 (do not catch general exception types) is what would have
		     flagged the log-and-swallow handlers this codebase had everywhere. Warnings only,
		     so an unrelated finding never blocks a build. -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<!-- Application icon for exe and shell extension -->
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- ShellExtension DLL path based on platform and configuration -->
	<PropertyGroup>
		<ShellExtensionDllPath Condition="'$(Platform)' == 'x64'">$(SolutionDir)x64\$(Configuration)\ShellExtension.dll</ShellExtensionDllPath>
		<ShellExtensionDllPath Condition="'$(Platform)' == 'x86'">$(SolutionDir)Win32\$(Configuration)\ShellExtension.dll</ShellExtensionDllPath>
		<ShellExtensionDllPath Condition="'$(Platform)' == 'ARM64'">$(SolutionDir)x64\$(Configuration)\ShellExtension.dll</ShellExtensionDllPath>
		<ShellExtensionDllPathFallback>$(SolutionDir)ShellExtension.dll</ShellExtensionDllPathFallback>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove=".github\**" />
	  <Compile Remove="Gladhen3.Tests\**" />
	  <EmbeddedResource Remove=".github\**" />
	  <EmbeddedResource Remove="Gladhen3.Tests\**" />
	  <None Remove=".github\**" />
	  <None Remove="Gladhen3.Tests\**" />
	  <Page Remove=".github\**" />
	  <Page Remove="Gladhen3.Tests\**" />
	</ItemGroup>
	<ItemGroup>
	  <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
	    <_Parameter1>Gladhen3.Tests</_Parameter1>
	  </AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\SplashScreen.scale-200.png" />
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />
		<Content Include="Assets\app.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>
	<ItemGroup>
		<!-- PDFsharp (MIT) replaces iText (AGPL). ~0.9 MB smaller and no copyleft
		     obligation on a Store-shipped binary. -->
		<PackageReference Include="PDFsharp" Version="6.2.4" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!-- SkiaSharp removed: libSkiaSharp.dll alone was 3.48 MB of the package. All
		     decode/resize/encode now goes through WIC (Windows.Graphics.Imaging), which
		     ships in the OS and costs zero package bytes. -->
		<!-- System.Drawing.Common was referenced but never used anywhere in the source. -->

		<!-- SIZE: WindowsAppSDK 2.3.1 transitively drags DirectML.dll + onnxruntime.dll for
		     win-x64, win-arm64 AND win-arm64ec into EVERY package (~49 MB compressed each,
		     ~82% of the whole payload). This app contains no ML code whatsoever. -->
		<PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.74" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.3.4" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Interop\" />
	</ItemGroup>
	
	<!-- Reference ShellExtension.dll from build output or fallback to root -->
	<ItemGroup>
	  <None Include="$(ShellExtensionDllPath)" Condition="Exists('$(ShellExtensionDllPath)')">
	    <Link>ShellExtension.dll</Link>
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
	  <None Include="$(ShellExtensionDllPathFallback)" Condition="!Exists('$(ShellExtensionDllPath)') And Exists('$(ShellExtensionDllPathFallback)')">
	    <Link>ShellExtension.dll</Link>
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<!-- Publish Properties -->
	<PropertyGroup>
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishTrimmed>false</PublishTrimmed>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<!-- Store uploads are signed by Microsoft after certification; local signing would
		     fail anyway because the store publisher (CN=GUID) never matches the dev cert. -->
		<AppxPackageSigningEnabled Condition="'$(UapAppxPackageBuildMode)' == 'StoreUpload'">False</AppxPackageSigningEnabled>
		<AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">True</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>44630DAA1A33E1662DF10F52D84E0EB33F5CA474</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<AppxBundle>Auto</AppxBundle>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<AppxBundlePlatforms>x86|x64</AppxBundlePlatforms>
		<GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
	</PropertyGroup>

	<!-- Copy ShellExtension.dll from C++ build output to Gladhen3 output -->
	<Target Name="CopyShellExtensionDll" AfterTargets="Build">
		<PropertyGroup>
			<ShellExtensionSource Condition="'$(Platform)' == 'x64'">$(SolutionDir)x64\$(Configuration)\ShellExtension.dll</ShellExtensionSource>
			<ShellExtensionSource Condition="'$(Platform)' == 'x86'">$(SolutionDir)Win32\$(Configuration)\ShellExtension.dll</ShellExtensionSource>
			<ShellExtensionSource Condition="'$(Platform)' == 'ARM64'">$(SolutionDir)x64\$(Configuration)\ShellExtension.dll</ShellExtensionSource>
			<ShellExtensionFallback>$(SolutionDir)ShellExtension.dll</ShellExtensionFallback>
		</PropertyGroup>
		<!-- Copy from C++ build output if exists -->
		<Copy SourceFiles="$(ShellExtensionSource)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(ShellExtensionSource)')" />
		<!-- Fallback: copy from solution root if C++ build output doesn't exist -->
		<Copy SourceFiles="$(ShellExtensionFallback)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="!Exists('$(ShellExtensionSource)') And Exists('$(ShellExtensionFallback)')" />
	</Target>
	<!-- SIZE: iText 9.x ships all 12 modules in one NuGet package. Gladhen3 only touches
	     iText.IO.Image, iText.Kernel.Pdf and iText.Kernel.Pdf.Canvas. Drop the rest.
	     itext.commons + itext.bouncy-castle-connector stay: kernel loads them at runtime
	     (encrypted / signed PDF handling). -->
	<ItemGroup>
	  <PRIResource Remove=".github\**" />
	</ItemGroup>
</Project>
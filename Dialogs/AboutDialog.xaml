<ContentDialog
    x:Class="Gladhen3.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Gladhen3.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="AboutDialog"
    CloseButtonStyle="{StaticResource DefaultButtonStyle}">

    <StackPanel Spacing="8">
        <TextBlock x:Uid="AboutDialog_Description" TextWrapping="Wrap" />
        <TextBlock x:Uid="AboutDialog_Version" />
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Uid="AboutDialog_Repository" VerticalAlignment="Center" />
            <HyperlinkButton Content="github.com/armiaab/Gladhen3" NavigateUri="https://github.com/armiaab/Gladhen3" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

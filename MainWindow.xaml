<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Gladhen3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="using:Gladhen3.Selectors"
    Title="Gladhen3"
    Closed="Window_Closed"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!--
                One menu shared by every page. It acts on the page it was opened on, or
                on the whole selection when that page is part of it - which page that is
                gets worked out when it opens, from the element it was opened over.
            -->
            <MenuFlyout x:Key="PageMenu" Opening="PageMenu_Opening">
                <MenuFlyoutItem
                    x:Uid="MenuPreview"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Enter"
                    Tag="Preview">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Uid="MenuRotateRight"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+R"
                    Tag="RotateRight">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7AD;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="MenuRotateLeft"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+L"
                    Tag="RotateLeft">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7AD;" Style="{StaticResource MirroredIconStyle}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="MenuRotate180"
                    Click="PageMenuItem_Click"
                    Tag="Rotate180" />
                <MenuFlyoutItem
                    x:Uid="MenuNormalize"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+R"
                    Tag="Normalize">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B4;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Uid="MenuDuplicate"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+D"
                    Tag="Duplicate">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="MenuInsertBlank"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+B"
                    Tag="InsertBlank">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="MenuSplitHere"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+Enter"
                    Tag="SplitHere" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Uid="MenuExtract"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                    Tag="Extract">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="MenuRemovePages"
                    Click="PageMenuItem_Click"
                    KeyboardAcceleratorTextOverride="Delete"
                    Tag="Remove">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title Bar with Menu  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  App Icon and Title  -->
            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    x:Name="AppIconImage"
                    Width="16"
                    Height="16"
                    Source="ms-appx:///Assets/Square44x44Logo.png" />
                <TextBlock
                    x:Uid="AppTitle"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!--  Menu Bar in Title Bar  -->
            <MenuBar
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Background="Transparent">
                <MenuBarItem x:Uid="MenuFile">
                    <MenuFlyoutItem x:Uid="MenuAddFiles" Click="AddFilesButton_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuAddImages" Click="AddImagesButton_Click" />
                    <MenuFlyoutItem x:Uid="MenuAddPdfs" Click="AddPdfsButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuExit" Click="ExitMenuItem_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuEdit">
                    <MenuFlyoutItem
                        x:Name="UndoMenuItem"
                        x:Uid="MenuUndo"
                        Click="Undo_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7A7;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="RedoMenuItem"
                        x:Uid="MenuRedo"
                        Click="Redo_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7A6;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Y" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="SelectModeMenuItem"
                        x:Uid="MenuEnterSelectMode"
                        Click="ToggleSelectModeMenu_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="E" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="SelectAllMenuItem"
                        x:Uid="MenuSelectAll"
                        Click="SelectAllButton_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="A" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuDeselectAll" Click="DeselectAllButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="RemoveMenuItem"
                        x:Uid="MenuRemoveSelected"
                        Click="PageCommand_Click"
                        Tag="Remove">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuRemoveAll" Click="RemoveAll_Click" />
                </MenuBarItem>
                <!--
                    The quick edits. Each acts on the selection in select mode, otherwise on the
                    page last clicked - the same pages the right-click menu below acts on.
                -->
                <MenuBarItem x:Uid="MenuPage">
                    <MenuFlyoutItem
                        x:Uid="MenuRotateRight"
                        Click="PageCommand_Click"
                        Tag="RotateRight">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7AD;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="MenuRotateLeft"
                        Click="PageCommand_Click"
                        Tag="RotateLeft">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7AD;" Style="{StaticResource MirroredIconStyle}" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="L" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="MenuRotate180"
                        Click="PageCommand_Click"
                        Tag="Rotate180" />
                    <MenuFlyoutItem
                        x:Uid="MenuNormalize"
                        Click="PageCommand_Click"
                        Tag="Normalize">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8B4;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="MenuDuplicate"
                        Click="PageCommand_Click"
                        Tag="Duplicate">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="D" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="MenuInsertBlank"
                        Click="PageCommand_Click"
                        Tag="InsertBlank">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7C3;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="B" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="MenuReverse"
                        Click="PageCommand_Click"
                        Tag="Reverse">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuSelectOdd" Click="SelectOddPages_Click" />
                    <MenuFlyoutItem x:Uid="MenuSelectEven" Click="SelectEvenPages_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="MenuExtract"
                        Click="PageCommand_Click"
                        Tag="Extract">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuView">
                    <MenuFlyoutItem
                        x:Uid="MenuPreview"
                        Click="PageCommand_Click"
                        KeyboardAcceleratorTextOverride="Enter"
                        Tag="Preview">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A1;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuThumbnails" Click="SwitchToGridView_Click" />
                    <MenuFlyoutItem x:Uid="MenuList" Click="SwitchToListView_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuSort">
                    <MenuFlyoutItem x:Uid="MenuSortNameAsc" Click="SortByFileNameAsc_Click" />
                    <MenuFlyoutItem x:Uid="MenuSortNameDesc" Click="SortByFileNameDesc_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuSortTypeAsc" Click="SortByTypeAsc_Click" />
                    <MenuFlyoutItem x:Uid="MenuSortTypeDesc" Click="SortByTypeDesc_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuSplit">
                    <MenuFlyoutItem x:Uid="MenuSplitHere" Click="SplitHere_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuSplitBySource" Click="SplitBySource_Click" />
                    <MenuFlyoutItem x:Uid="MenuSplitEveryN" Click="SplitEveryN_Click" />
                    <MenuFlyoutItem x:Uid="MenuSplitIntoN" Click="SplitIntoN_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuRemoveAllSplits" Click="RemoveAllSplits_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuTools">
                    <MenuFlyoutItem x:Uid="MenuSettings" Click="SettingsButton_Click" />
                    <MenuFlyoutItem x:Uid="MenuLogs" Click="LogButton_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuHelp">
                    <MenuFlyoutItem x:Uid="MenuAbout" Click="AboutButton_Click" />
                </MenuBarItem>
            </MenuBar>
        </Grid>

        <!--  Header: title on the left, the actions that act on the whole list on the right  -->
        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Uid="HeaderPages" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Name="ItemCountTextBlock"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

                <!--
                    Adding files was previously reachable only through the menu bar, which is
                    the one thing a first-time user needs and the last place they look.
                -->
                <Button
                    x:Name="AddFilesButton"
                    x:Uid="TooltipAddFiles"
                    Padding="12,6"
                    Click="AddFilesButton_Click"
                    CornerRadius="{StaticResource SmallCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="ButtonAddFilesLabel" />
                    </StackPanel>
                </Button>

                <!--  The edits made most often, one click away; the Page menu has the rest.  -->
                <Border Style="{StaticResource ToolGroupStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="RotateLeftButton"
                            x:Uid="TooltipRotateLeft"
                            Click="PageCommand_Click"
                            Style="{StaticResource ToolButtonStyle}"
                            Tag="RotateLeft">
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE7AD;"
                                Style="{StaticResource MirroredIconStyle}" />
                        </Button>
                        <Button
                            x:Name="RotateRightButton"
                            x:Uid="TooltipRotateRight"
                            Click="PageCommand_Click"
                            Style="{StaticResource ToolButtonStyle}"
                            Tag="RotateRight">
                            <FontIcon FontSize="14" Glyph="&#xE7AD;" />
                        </Button>
                        <Button
                            x:Name="NormalizeButton"
                            x:Uid="TooltipNormalize"
                            Click="PageCommand_Click"
                            Style="{StaticResource ToolButtonStyle}"
                            Tag="Normalize">
                            <FontIcon FontSize="14" Glyph="&#xE8B4;" />
                        </Button>

                        <Border Margin="2,0" Style="{StaticResource ToolSeparatorStyle}" />

                        <Button
                            x:Name="DuplicateButton"
                            x:Uid="TooltipDuplicate"
                            Click="PageCommand_Click"
                            Style="{StaticResource ToolButtonStyle}"
                            Tag="Duplicate">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        </Button>
                        <Button
                            x:Name="RemovePagesButton"
                            x:Uid="TooltipRemovePages"
                            Click="PageCommand_Click"
                            Style="{StaticResource ToolButtonStyle}"
                            Tag="Remove">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>

                        <Border Margin="2,0" Style="{StaticResource ToolSeparatorStyle}" />

                        <Button
                            x:Name="UndoButton"
                            x:Uid="TooltipUndo"
                            Click="Undo_Click"
                            Style="{StaticResource ToolButtonStyle}">
                            <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                        </Button>
                    </StackPanel>
                </Border>

                <!--  Related buttons share one bordered group instead of floating separately.  -->
                <Border Style="{StaticResource ToolGroupStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton
                            x:Name="SelectModeToggle"
                            x:Uid="TooltipSelectMode"
                            Checked="SelectModeToggle_Checked"
                            Style="{StaticResource ToolToggleButtonStyle}"
                            Unchecked="SelectModeToggle_Unchecked">
                            <FontIcon FontSize="14" Glyph="&#xE762;" />
                        </ToggleButton>

                        <Border Margin="2,0" Style="{StaticResource ToolSeparatorStyle}" />

                        <ToggleButton
                            x:Name="GridViewToggle"
                            x:Uid="TooltipThumbnails"
                            Checked="GridViewToggle_Checked"
                            IsChecked="True"
                            Style="{StaticResource ToolToggleButtonStyle}"
                            Unchecked="GridViewToggle_Unchecked">
                            <FontIcon FontSize="14" Glyph="&#xF0E2;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ListViewToggle"
                            x:Uid="TooltipList"
                            Checked="ListViewToggle_Checked"
                            Style="{StaticResource ToolToggleButtonStyle}"
                            Unchecked="ListViewToggle_Unchecked">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  Content Area  -->
        <Border
            Grid.Row="2"
            Margin="{StaticResource PageMargin}"
            Style="{StaticResource SurfaceBorderStyle}">
            <Grid>
                <Grid.Resources>
                    <!--
                        Pages and section dividers share one collection so that the built-in
                        drag reorder keeps working, so the row template is chosen per item.
                    -->
                    <DataTemplate x:Key="GridPageTemplate">
                        <Border
                            Width="140"
                            Height="175"
                            Margin="4"
                            AutomationProperties.Name="{Binding DisplayName}"
                            ContextFlyout="{StaticResource PageMenu}"
                            Style="{StaticResource ItemCardStyle}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource ThumbnailWellStyle}">
                                    <!--
                                        Square, so that a page turned a quarter still fits the
                                        well: a render transform turns the drawing, not the
                                        layout slot.
                                    -->
                                    <Grid
                                        Width="108"
                                        Height="108"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="{Binding ThumbnailAngle}" />
                                        </Grid.RenderTransform>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        <FontIcon
                                            FontSize="36"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="{Binding TypeIcon}"
                                            Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding FileName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding DisplayName}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource TertiaryTextStyle}"
                                    Text="{Binding PageInfo}" />
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!--
                        A wrapping grid cannot be made to break a line, so the divider reads as
                        a card of its own rather than as a rule across the surface. The list
                        view is the one that shows sections properly.
                    -->
                    <DataTemplate x:Key="GridSectionTemplate">
                        <Border
                            Width="140"
                            Height="175"
                            Margin="4"
                            AutomationProperties.Name="{Binding SectionName}"
                            Background="{ThemeResource AccentAcrylicBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <FontIcon
                                        HorizontalAlignment="Left"
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE8B7;" />
                                    <Button
                                        x:Uid="TooltipRemoveSplit"
                                        Padding="4"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveSectionBreak_Click">
                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>

                                <TextBox
                                    Grid.Row="1"
                                    Margin="0,6,0,0"
                                    VerticalAlignment="Top"
                                    x:Uid="SectionNameBox"
                                    AcceptsReturn="False"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    GotFocus="SectionName_GotFocus"
                                    LostFocus="SectionName_LostFocus"
                                    Text="{Binding SectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource TertiaryTextStyle}"
                                    Text="{Binding SectionSummary}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource TertiaryTextStyle}"
                                    Text="{Binding SectionEstimate}" />
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <DataTemplate x:Key="ListPageTemplate">
                        <Grid
                            Padding="8,6"
                            AutomationProperties.Name="{Binding DisplayName}"
                            Background="Transparent"
                            ContextFlyout="{StaticResource PageMenu}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="36"
                                Height="44"
                                Style="{StaticResource ThumbnailWellStyle}">
                                <Grid
                                    Width="36"
                                    Height="36"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{Binding ThumbnailAngle}" />
                                    </Grid.RenderTransform>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="{Binding TypeIcon}"
                                        Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    Text="{Binding FileName}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{Binding DisplayName}" />
                                <TextBlock
                                    Style="{StaticResource TertiaryTextStyle}"
                                    Text="{Binding FilePath}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{Binding PageInfo}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{Binding SizeInfo}" />
                        </Grid>
                    </DataTemplate>

                    <!--
                        The band that starts an output file. Its name is edited in place: the
                        name IS the file name, so making the user open a dialog to set the one
                        thing this row exists for would be perverse.
                    -->
                    <DataTemplate x:Key="ListSectionTemplate">
                        <Border
                            Margin="0,6,0,2"
                            Padding="10,7"
                            AutomationProperties.Name="{Binding SectionName}"
                            Background="{ThemeResource AccentAcrylicBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8B7;" />

                                <TextBox
                                    x:Uid="SectionNameBox"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    AcceptsReturn="False"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    GotFocus="SectionName_GotFocus"
                                    LostFocus="SectionName_LostFocus"
                                    Text="{Binding SectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{Binding SectionSummary}" />

                                <TextBlock
                                    Grid.Column="3"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{Binding SectionEstimate}" />

                                <Button
                                    x:Uid="TooltipRemoveSplit"
                                    Grid.Column="4"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="RemoveSectionBreak_Click">
                                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <selectors:DocumentTemplateSelector
                        x:Key="GridTemplateSelector"
                        PageTemplate="{StaticResource GridPageTemplate}"
                        SectionBreakTemplate="{StaticResource GridSectionTemplate}" />
                    <selectors:DocumentTemplateSelector
                        x:Key="ListTemplateSelector"
                        PageTemplate="{StaticResource ListPageTemplate}"
                        SectionBreakTemplate="{StaticResource ListSectionTemplate}" />
                </Grid.Resources>

                <!--  Grid View  -->
                <GridView
                    x:Name="DocumentGridView"
                    Padding="8"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DoubleTapped="DocumentView_DoubleTapped"
                    DragItemsCompleted="DocumentView_DragItemsCompleted"
                    DragItemsStarting="DocumentView_DragItemsStarting"
                    DragOver="DocumentView_DragOver"
                    Drop="DocumentView_Drop"
                    GotFocus="DocumentView_GotFocus"
                    ItemTemplateSelector="{StaticResource GridTemplateSelector}"
                    PreviewKeyDown="DocumentView_PreviewKeyDown"
                    ReorderMode="Enabled"
                    SelectionChanged="DocumentView_SelectionChanged"
                    SelectionMode="None">
                    <!--
                        Pages arriving, leaving and being dragged into a new order are the
                        three things that actually happen in this list, so each one gets a
                        transition rather than snapping.
                    -->
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <ReorderThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <!--  List View  -->
                <ListView
                    x:Name="DocumentListView"
                    Padding="4"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DoubleTapped="DocumentView_DoubleTapped"
                    DragItemsCompleted="DocumentView_DragItemsCompleted"
                    DragItemsStarting="DocumentView_DragItemsStarting"
                    DragOver="DocumentView_DragOver"
                    Drop="DocumentView_Drop"
                    GotFocus="DocumentView_GotFocus"
                    ItemTemplateSelector="{StaticResource ListTemplateSelector}"
                    PreviewKeyDown="DocumentView_PreviewKeyDown"
                    ReorderMode="Enabled"
                    SelectionChanged="DocumentView_SelectionChanged"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <ReorderThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                </ListView>

                <!--
                    Empty state. It accepts drops itself: it covers the middle of the surface,
                    so without its own handlers it would be a dead zone in the one place a
                    first-time user is most likely to aim.
                -->
                <Grid
                    x:Name="EmptyStatePanel"
                    AllowDrop="True"
                    Background="Transparent"
                    DragOver="DocumentView_DragOver"
                    Drop="DocumentView_Drop">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <Border
                            Width="72"
                            Height="72"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SurfaceCornerRadius}">
                            <FontIcon
                                FontSize="30"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE896;" />
                        </Border>
                        <TextBlock
                            x:Uid="EmptyStateTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Uid="EmptyStateSubtitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TertiaryTextStyle}" />
                        <Button
                            x:Name="EmptyStateAddButton"
                            x:Uid="EmptyStateAddFiles"
                            Margin="0,12,0,0"
                            Padding="16,7"
                            HorizontalAlignment="Center"
                            Click="AddFilesButton_Click"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--
            The page viewer. It covers the header and the page list but not the bottom bar, so
            the status line, the size estimate and Save stay where they always are. Every page
            command - toolbar, menus, shortcuts - acts on the page shown here while it is open.
        -->
        <Grid
            x:Name="ViewerPanel"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            PreviewKeyDown="ViewerPanel_PreviewKeyDown"
            Visibility="Collapsed">
            <Grid.Resources>
                <DataTemplate x:Key="FilmstripPageTemplate">
                    <Border
                        Width="60"
                        Height="76"
                        AutomationProperties.Name="{Binding DisplayName}"
                        ContextFlyout="{StaticResource PageMenu}"
                        Style="{StaticResource ThumbnailWellStyle}"
                        ToolTipService.ToolTip="{Binding DisplayName}">
                        <Grid
                            Width="56"
                            Height="56"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="{Binding ThumbnailAngle}" />
                            </Grid.RenderTransform>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="{Binding TypeIcon}"
                                Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>

                <!--  Where one output file ends and the next begins.  -->
                <DataTemplate x:Key="FilmstripSectionTemplate">
                    <Border
                        Width="4"
                        Height="76"
                        Margin="4,0"
                        AutomationProperties.Name="{Binding SectionName}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2"
                        ToolTipService.ToolTip="{Binding SectionName}" />
                </DataTemplate>

                <selectors:DocumentTemplateSelector
                    x:Key="FilmstripTemplateSelector"
                    PageTemplate="{StaticResource FilmstripPageTemplate}"
                    SectionBreakTemplate="{StaticResource FilmstripSectionTemplate}" />
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Toolbar: back and what is shown on the left, the page commands on the right.  -->
            <Grid Grid.Row="0" Margin="8,0,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MaxWidth="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Uid="ViewerBack"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Click="ViewerBack_Click"
                    Style="{StaticResource ToolButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="0">
                    <TextBlock
                        x:Name="ViewerTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="ViewerDetails"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--
                    A CommandBar rather than a row of buttons so that a narrow window folds the
                    rest into its "..." menu instead of cutting them off.
                -->
                <CommandBar
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="True"
                    OverflowButtonVisibility="Auto">
                    <AppBarButton
                        x:Uid="ViewerRotateLeft"
                        Click="PageCommand_Click"
                        Tag="RotateLeft">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7AD;" Style="{StaticResource MirroredIconStyle}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="ViewerRotateRight"
                        Click="PageCommand_Click"
                        Tag="RotateRight">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7AD;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="ViewerNormalize"
                        Click="PageCommand_Click"
                        Tag="Normalize">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B4;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Uid="ViewerDuplicate"
                        Click="PageCommand_Click"
                        Tag="Duplicate">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="ViewerInsertBlank"
                        Click="PageCommand_Click"
                        Tag="InsertBlank">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7C3;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="ViewerSplitHere"
                        Click="PageCommand_Click"
                        Tag="SplitHere">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="ViewerExtract"
                        Click="PageCommand_Click"
                        Tag="Extract">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="ViewerRemove"
                        Click="PageCommand_Click"
                        Tag="Remove">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton x:Uid="ViewerZoomOut" Click="ViewerZoomOut_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71F;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarElementContainer VerticalContentAlignment="Center">
                        <TextBlock
                            x:Name="ViewerZoomText"
                            Width="48"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextAlignment="Center" />
                    </AppBarElementContainer>
                    <AppBarButton x:Uid="ViewerZoomIn" Click="ViewerZoomIn_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8A3;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton
                        x:Name="ViewerFitPageToggle"
                        x:Uid="ViewerFitPage"
                        Click="ViewerFitPage_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE9A6;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton
                        x:Name="ViewerFitWidthToggle"
                        x:Uid="ViewerFitWidth"
                        Click="ViewerFitWidth_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE799;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="ViewerOpenButton"
                        x:Uid="ViewerOpen"
                        Click="ViewerOpen_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <!--  The page.  -->
            <Grid Grid.Row="1">
                <ScrollViewer
                    x:Name="ViewerScroll"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    IsTabStop="True"
                    MaxZoomFactor="8"
                    MinZoomFactor="0.1"
                    SizeChanged="ViewerScroll_SizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    ViewChanged="ViewerScroll_ViewChanged"
                    ZoomMode="Enabled">
                    <!--
                        Sized to the page at 100%; the scroll viewer's zoom does the rest, and the
                        bitmap is re-rendered whenever the zoom needs more pixels than it has.
                    -->
                    <Grid
                        x:Name="ViewerSheet"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        DoubleTapped="ViewerSheet_DoubleTapped">
                        <Image x:Name="ViewerImage" Stretch="Fill" />
                        <TextBlock
                            x:Name="ViewerMessage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="Gray"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>

                <ProgressRing
                    x:Name="ViewerProgress"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />

                <!--  For the mouse; the keyboard has Left/Right and PageUp/PageDown.  -->
                <Button
                    x:Name="ViewerPreviousButton"
                    x:Uid="ViewerPrevious"
                    Width="40"
                    Height="40"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="ViewerPrevious_Click"
                    CornerRadius="20"
                    Opacity="0.85">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <Button
                    x:Name="ViewerNextButton"
                    x:Uid="ViewerNext"
                    Width="40"
                    Height="40"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="ViewerNext_Click"
                    CornerRadius="20"
                    Opacity="0.85">
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>

                <Border
                    Margin="0,0,0,12"
                    Padding="10,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SmallCornerRadius}">
                    <TextBlock x:Name="ViewerCounter" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>

            <!--  Every page, to jump straight to one.  -->
            <ListView
                x:Name="Filmstrip"
                Grid.Row="2"
                Height="96"
                Padding="8,4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ItemTemplateSelector="{StaticResource FilmstripTemplateSelector}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectionChanged="Filmstrip_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="3" />
                        <Setter Property="Margin" Value="1,0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!--  Bottom Bar  -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Saving and normalizing are the slow things this app does; say so.  -->
                <ProgressBar
                    x:Name="BusyBar"
                    Grid.Row="0"
                    Height="2"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <Grid Grid.Row="1" Padding="{StaticResource BarPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="SelectionInfoPanel"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Button
                            x:Uid="TooltipRemoveSelected"
                            Click="PageCommand_Click"
                            Style="{StaticResource ToolButtonStyle}"
                            Tag="Remove">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                        <TextBlock
                            x:Name="SelectionCountText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}" />
                        <Border Margin="4,0" Style="{StaticResource ToolSeparatorStyle}" />
                    </StackPanel>

                    <Grid Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="StatusTextBlock"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextTrimming="CharacterEllipsis" />

                        <!--
                            Normalize's own actions: stopping a long check, and afterwards
                            picking out the pages it could not judge, which are the ones that
                            still need a look.
                        -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <HyperlinkButton
                                x:Name="NormalizeStopButton"
                                x:Uid="ButtonStopNormalize"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Click="NormalizeStop_Click"
                                Visibility="Collapsed" />
                            <HyperlinkButton
                                x:Name="NormalizeReviewButton"
                                x:Uid="ButtonSelectLeftAlone"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Click="NormalizeReview_Click"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">

                        <!--
                            Estimated output size. The point of the compression presets is a
                            smaller file, and until now nothing told the user whether the
                            setting they picked actually achieved one.
                        -->
                        <!--  Only shown once there is more than one file to describe.  -->
                        <TextBlock
                            x:Name="OutputCountText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Visibility="Collapsed" />

                        <StackPanel
                            x:Name="EstimatePanel"
                            x:Uid="TooltipEstimatedSize"
                            VerticalAlignment="Center"
                            Opacity="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                            <ProgressRing
                                x:Name="EstimateProgress"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <FontIcon
                                x:Name="EstimateIcon"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE7C3;" />
                            <TextBlock
                                x:Name="EstimatedSizeText"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>

                        <Button
                            x:Name="SaveButton"
                            x:Uid="ButtonSavePdf"
                            Padding="24,8"
                            Click="SaveButton_Click"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

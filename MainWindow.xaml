<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Gladhen3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Gladhen3"
    Closed="Window_Closed"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title Bar with Menu  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  App Icon and Title  -->
            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Image
                    x:Name="AppIconImage"
                    Width="16"
                    Height="16"
                    Source="ms-appx:///Assets/Square44x44Logo.png" />
                <TextBlock
                    x:Uid="AppTitle"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!--  Menu Bar in Title Bar  -->
            <MenuBar
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Background="Transparent">
                <MenuBarItem x:Uid="MenuFile">
                    <MenuFlyoutItem x:Uid="MenuAddFiles" Click="AddFilesButton_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuAddImages" Click="AddImagesButton_Click" />
                    <MenuFlyoutItem x:Uid="MenuAddPdfs" Click="AddPdfsButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuExit" Click="ExitMenuItem_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuEdit">
                    <MenuFlyoutItem
                        x:Name="SelectModeMenuItem"
                        x:Uid="MenuEnterSelectMode"
                        Click="ToggleSelectModeMenu_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="E" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuSelectAll" Click="SelectAllButton_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="A" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuDeselectAll" Click="DeselectAllButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuRemoveSelected" Click="RemoveSelected_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuRemoveAll" Click="RemoveAll_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuView">
                    <MenuFlyoutItem x:Uid="MenuThumbnails" Click="SwitchToGridView_Click" />
                    <MenuFlyoutItem x:Uid="MenuList" Click="SwitchToListView_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuSort">
                    <MenuFlyoutItem x:Uid="MenuSortNameAsc" Click="SortByFileNameAsc_Click" />
                    <MenuFlyoutItem x:Uid="MenuSortNameDesc" Click="SortByFileNameDesc_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="MenuSortTypeAsc" Click="SortByTypeAsc_Click" />
                    <MenuFlyoutItem x:Uid="MenuSortTypeDesc" Click="SortByTypeDesc_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuTools">
                    <MenuFlyoutItem x:Uid="MenuSettings" Click="SettingsButton_Click" />
                    <MenuFlyoutItem x:Uid="MenuLogs" Click="LogButton_Click" />
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuHelp">
                    <MenuFlyoutItem x:Uid="MenuAbout" Click="AboutButton_Click" />
                </MenuBarItem>
            </MenuBar>
        </Grid>

        <!--  Header: title on the left, the actions that act on the whole list on the right  -->
        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Uid="HeaderPages" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Name="ItemCountTextBlock"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

                <!--
                    Adding files was previously reachable only through the menu bar, which is
                    the one thing a first-time user needs and the last place they look.
                -->
                <Button
                    x:Name="AddFilesButton"
                    x:Uid="TooltipAddFiles"
                    Padding="12,6"
                    Click="AddFilesButton_Click"
                    CornerRadius="{StaticResource SmallCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="ButtonAddFilesLabel" />
                    </StackPanel>
                </Button>

                <!--  Related buttons share one bordered group instead of floating separately.  -->
                <Border Style="{StaticResource ToolGroupStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton
                            x:Name="SelectModeToggle"
                            x:Uid="TooltipSelectMode"
                            Checked="SelectModeToggle_Checked"
                            Style="{StaticResource ToolToggleButtonStyle}"
                            Unchecked="SelectModeToggle_Unchecked">
                            <FontIcon FontSize="14" Glyph="&#xE762;" />
                        </ToggleButton>

                        <Border Margin="2,0" Style="{StaticResource ToolSeparatorStyle}" />

                        <ToggleButton
                            x:Name="GridViewToggle"
                            x:Uid="TooltipThumbnails"
                            Checked="GridViewToggle_Checked"
                            IsChecked="True"
                            Style="{StaticResource ToolToggleButtonStyle}"
                            Unchecked="GridViewToggle_Unchecked">
                            <FontIcon FontSize="14" Glyph="&#xF0E2;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="ListViewToggle"
                            x:Uid="TooltipList"
                            Checked="ListViewToggle_Checked"
                            Style="{StaticResource ToolToggleButtonStyle}"
                            Unchecked="ListViewToggle_Unchecked">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  Content Area  -->
        <Border
            Grid.Row="2"
            Margin="{StaticResource PageMargin}"
            Style="{StaticResource SurfaceBorderStyle}">
            <Grid>
                <!--  Grid View  -->
                <GridView
                    x:Name="DocumentGridView"
                    Padding="8"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DoubleTapped="DocumentView_DoubleTapped"
                    DragItemsCompleted="DocumentView_DragItemsCompleted"
                    DragItemsStarting="DocumentView_DragItemsStarting"
                    DragOver="DocumentView_DragOver"
                    Drop="DocumentView_Drop"
                    ReorderMode="Enabled"
                    SelectionChanged="DocumentView_SelectionChanged"
                    SelectionMode="None">
                    <!--
                        Pages arriving, leaving and being dragged into a new order are the
                        three things that actually happen in this list, so each one gets a
                        transition rather than snapping.
                    -->
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <ReorderThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="140"
                                Height="175"
                                Margin="4"
                                Style="{StaticResource ItemCardStyle}">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource ThumbnailWellStyle}">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            <FontIcon
                                                FontSize="36"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Glyph="{Binding TypeIcon}"
                                                Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding DisplayName}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource TertiaryTextStyle}"
                                        Text="{Binding PageInfo}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <!--  List View  -->
                <ListView
                    x:Name="DocumentListView"
                    Padding="4"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DoubleTapped="DocumentView_DoubleTapped"
                    DragItemsCompleted="DocumentView_DragItemsCompleted"
                    DragItemsStarting="DocumentView_DragItemsStarting"
                    DragOver="DocumentView_DragOver"
                    Drop="DocumentView_Drop"
                    ReorderMode="Enabled"
                    SelectionChanged="DocumentView_SelectionChanged"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ContentThemeTransition />
                            <ReorderThemeTransition />
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="36"
                                    Height="44"
                                    Style="{StaticResource ThumbnailWellStyle}">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        <FontIcon
                                            FontSize="18"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="{Binding TypeIcon}"
                                            Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{Binding DisplayName}" />
                                    <TextBlock
                                        Style="{StaticResource TertiaryTextStyle}"
                                        Text="{Binding FilePath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{Binding PageInfo}" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{Binding SizeInfo}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    Empty state. It accepts drops itself: it covers the middle of the surface,
                    so without its own handlers it would be a dead zone in the one place a
                    first-time user is most likely to aim.
                -->
                <Grid
                    x:Name="EmptyStatePanel"
                    AllowDrop="True"
                    Background="Transparent"
                    DragOver="DocumentView_DragOver"
                    Drop="DocumentView_Drop">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <Border
                            Width="72"
                            Height="72"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SurfaceCornerRadius}">
                            <FontIcon
                                FontSize="30"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE896;" />
                        </Border>
                        <TextBlock
                            x:Uid="EmptyStateTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Uid="EmptyStateSubtitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TertiaryTextStyle}" />
                        <Button
                            x:Name="EmptyStateAddButton"
                            x:Uid="EmptyStateAddFiles"
                            Margin="0,12,0,0"
                            Padding="16,7"
                            HorizontalAlignment="Center"
                            Click="AddFilesButton_Click"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Bottom Bar  -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  A saving PDF is the one slow thing this app does; say so.  -->
                <ProgressBar
                    x:Name="BusyBar"
                    Grid.Row="0"
                    Height="2"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <Grid Grid.Row="1" Padding="{StaticResource BarPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="SelectionInfoPanel"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Button
                            x:Uid="TooltipRemoveSelected"
                            Click="RemoveSelected_Click"
                            Style="{StaticResource ToolButtonStyle}">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                        <TextBlock
                            x:Name="SelectionCountText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}" />
                        <Border Margin="4,0" Style="{StaticResource ToolSeparatorStyle}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="StatusTextBlock"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">

                        <!--
                            Estimated output size. The point of the compression presets is a
                            smaller file, and until now nothing told the user whether the
                            setting they picked actually achieved one.
                        -->
                        <StackPanel
                            x:Name="EstimatePanel"
                            x:Uid="TooltipEstimatedSize"
                            VerticalAlignment="Center"
                            Opacity="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                            <ProgressRing
                                x:Name="EstimateProgress"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <FontIcon
                                x:Name="EstimateIcon"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE7C3;" />
                            <TextBlock
                                x:Name="EstimatedSizeText"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>

                        <Button
                            x:Name="SaveButton"
                            x:Uid="ButtonSavePdf"
                            Padding="24,8"
                            Click="SaveButton_Click"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
